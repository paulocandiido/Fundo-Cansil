# Copie este arquivo para .env e ajuste os valores para sua maquina.
# O arquivo .env real nao deve ser enviado para o Git.

SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5433/cursodb
DB_USERNAME=postgres
DB_PASSWORD=***

# Variaveis utilizadas pelo Docker Compose
POSTGRES_DB=cursodb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=***
POSTGRES_PORT=5433
APP_PORT=8080
FRONTEND_PORT=4200
# Banco já existente nesta máquina. Para instalação nova, veja DOCKER.md.
POSTGRES_VOLUME_NAME=cansil_postgres_data

# Origens do front, separadas por virgula, sem barra final. Nunca use *.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:4200,http://127.0.0.1:5173

# Tokens falsos: substitua somente no arquivo .env local
BRAPI_TOKEN=token-brapi-fake
ALPHAVANTAGE_TOKEN=token-alphavantage-fake
HGFINANCE_TOKEN=token-hgfinance-fake
# Temporariamente desativados; tokens so sao obrigatorios quando enabled=true.
ALPHAVANTAGE_ENABLED=false
HGFINANCE_ENABLED=false
JWT_SECRET=chave-jwt-fake-com-pelo-menos-32-bytes
JWT_EXPIRATION_SECONDS=3600
BRAPI_BASE_URL=https://brapi.dev
ALPHAVANTAGE_BASE_URL=https://www.alphavantage.co
HGFINANCE_BASE_URL=https://api.hgbrasil.com
