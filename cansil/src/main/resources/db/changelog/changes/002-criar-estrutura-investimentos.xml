<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
 <changeSet id="004-sequencias-investimentos" author="curso"><createSequence sequenceName="seq_usuario"/><createSequence sequenceName="seq_ativo"/><createSequence sequenceName="seq_transacao"/><createSequence sequenceName="seq_consulta"/></changeSet>
 <changeSet id="005-tabelas-investimentos" author="curso">
  <createTable tableName="usuario"><column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column><column name="nome" type="VARCHAR(120)"><constraints nullable="false"/></column><column name="email" type="VARCHAR(160)"><constraints nullable="false" unique="true"/></column><column name="cpf" type="VARCHAR(14)"><constraints nullable="false" unique="true"/></column><column name="senha_hash" type="VARCHAR(100)"><constraints nullable="false"/></column></createTable>
  <createTable tableName="ativo"><column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column><column name="simbolo" type="VARCHAR(20)"><constraints nullable="false" unique="true"/></column><column name="nome" type="VARCHAR(160)"><constraints nullable="false"/></column><column name="bolsa" type="VARCHAR(30)"><constraints nullable="false"/></column></createTable>
  <createTable tableName="transacao"><column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column><column name="usuario_id" type="BIGINT"><constraints nullable="false"/></column><column name="ativo_id" type="BIGINT"><constraints nullable="false"/></column><column name="tipo" type="VARCHAR(10)"><constraints nullable="false"/></column><column name="quantidade" type="DECIMAL(19,6)"><constraints nullable="false"/></column><column name="valor_unitario" type="DECIMAL(19,6)"><constraints nullable="false"/></column><column name="data_operacao" type="TIMESTAMP"><constraints nullable="false"/></column></createTable>
  <createTable tableName="consulta"><column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column><column name="usuario_id" type="BIGINT"><constraints nullable="false"/></column><column name="ativo_id" type="BIGINT"><constraints nullable="false"/></column><column name="valor" type="DECIMAL(19,6)"><constraints nullable="false"/></column><column name="fonte" type="VARCHAR(30)"><constraints nullable="false"/></column><column name="consultado_em" type="TIMESTAMP"><constraints nullable="false"/></column></createTable>
  <addForeignKeyConstraint baseTableName="transacao" baseColumnNames="usuario_id" referencedTableName="usuario" referencedColumnNames="id" constraintName="fk_transacao_usuario"/><addForeignKeyConstraint baseTableName="transacao" baseColumnNames="ativo_id" referencedTableName="ativo" referencedColumnNames="id" constraintName="fk_transacao_ativo"/><addForeignKeyConstraint baseTableName="consulta" baseColumnNames="usuario_id" referencedTableName="usuario" referencedColumnNames="id" constraintName="fk_consulta_usuario"/><addForeignKeyConstraint baseTableName="consulta" baseColumnNames="ativo_id" referencedTableName="ativo" referencedColumnNames="id" constraintName="fk_consulta_ativo"/>
  <createIndex tableName="transacao" indexName="idx_transacao_usuario_ativo_data"><column name="usuario_id"/><column name="ativo_id"/><column name="data_operacao"/></createIndex><createIndex tableName="consulta" indexName="idx_consulta_usuario_data"><column name="usuario_id"/><column name="consultado_em"/></createIndex>
 </changeSet>
</databaseChangeLog>
